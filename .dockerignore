# Git history and configuration
.git/
.gitignore
.gitattributes

# Docker specific
Dockerfile
.dockerignore

# Python bytecode and cache
__pycache__/
*.py[cod]
*.pyc
*$py.class

# Distribution / packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
wheels/

# Local virtual environments
.venv
.venv*
env/
venv/
ENV/
locust_env/

# OS-specific files
.DS_Store
Thumbs.db

# IDE / Editor specific
.idea/
*.project
*.classpath
*.c9/
*.launch
.settings/
*.sublime-workspace
# .vscode/ # Keep .vscode if it contains useful launch/settings for the *container* environment
.history/

# Test reports and cache
htmlcov/
.coverage
.coverage.*
.pytest_cache/
*.cover
nosetests.xml
coverage.xml
tests/load_test/.results/

# Temporary files / logs
*.log
log/
logs/
*.tmp
tmp*

# Local configuration / secrets (should not be in version control anyway)
.env
*.env
local_settings.py

# Terraform state files (if accidentally included in context)
.terraform/
*.tfstate
*.tfstate.*
my_env.tfvars

# Node.js
node_modules/
npm-debug.log
yarn-error.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Miscellaneous from .gitignore that are good to exclude
.cache/
.tox/
.nox/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Files generated by the agent-starter-pack that will be regenerated or are specific to local dev
.requirements.txt
# deployment_metadata.json # keep for now, might be useful for reference inside container

# Sample specific venv if it exists and docker context is higher up
# sample/.venv/ 